Cell[BoxData[
 RowBox[{
  RowBox[{"SubLaplace", "=", 
   RowBox[{"{", 
    RowBox[{
     RowBox[{
      SuperscriptBox[
       SubscriptBox["Y", "lm"], 
       TagBox[
        RowBox[{"(", 
         RowBox[{"2", ",", "0"}], ")"}],
        Derivative],
       MultilineFunction->None], "[", 
      RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}], "->", " ", 
     RowBox[{
      RowBox[{
       RowBox[{"-", "\[ScriptL]"}], 
       RowBox[{"(", 
        RowBox[{"\[ScriptL]", "+", "1"}], ")"}], " ", 
       RowBox[{
        SubscriptBox["Y", "lm"], "[", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], "-", 
      RowBox[{
       SuperscriptBox[
        RowBox[{"Csc", "[", "\[Theta]", "]"}], "2"], " ", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["Y", "lm"], 
         TagBox[
          RowBox[{"(", 
           RowBox[{"0", ",", "2"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}], "-", 
      RowBox[{
       RowBox[{"Cot", "[", "\[Theta]", "]"}], " ", 
       RowBox[{
        SuperscriptBox[
         SubscriptBox["Y", "lm"], 
         TagBox[
          RowBox[{"(", 
           RowBox[{"1", ",", "0"}], ")"}],
          Derivative],
         MultilineFunction->None], "[", 
        RowBox[{"\[Theta]", ",", "\[Phi]"}], "]"}]}]}]}], "}"}]}], 
  ";"}]], "Input",
