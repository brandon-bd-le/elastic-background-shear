Cell[BoxData[
 RowBox[{
  RowBox[{"dT", "=", 
   RowBox[{"Table", "[", 
    RowBox[{
     RowBox[{"Sum", "[", 
      RowBox[{
       RowBox[{
        RowBox[{"D", "[", 
         RowBox[{
          RowBox[{"T", "[", 
           RowBox[{"[", 
            RowBox[{"s1", ",", "i"}], "]"}], "]"}], ",", 
          RowBox[{"coord", "[", 
           RowBox[{"[", "s1", "]"}], "]"}]}], "]"}], "+", 
        RowBox[{"Sum", "[", 
         RowBox[{
          RowBox[{
           RowBox[{
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{"[", 
              RowBox[{"s1", ",", "s1", ",", "s2"}], "]"}], "]"}], " ", 
            RowBox[{"T", "[", 
             RowBox[{"[", 
              RowBox[{"s2", ",", "i"}], "]"}], "]"}]}], "+", 
           RowBox[{
            RowBox[{"\[CapitalGamma]", "[", 
             RowBox[{"[", 
              RowBox[{"i", ",", "s1", ",", "s2"}], "]"}], "]"}], " ", 
            RowBox[{"T", "[", 
             RowBox[{"[", 
              RowBox[{"s1", ",", "s2"}], "]"}], "]"}]}]}], ",", 
          RowBox[{"{", 
           RowBox[{"s2", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ",", 
       RowBox[{"{", 
        RowBox[{"s1", ",", "1", ",", "n"}], "}"}]}], "]"}], ",", 
     RowBox[{"{", 
      RowBox[{"i", ",", "1", ",", "n"}], "}"}]}], "]"}]}], ";"}]], "Input",
 CellChangeTimes->{{3.962820091300476*^9, 3.9628201100892334`*^9}, {
